# ====================================================================
# TRAINER AI BOT & WEBAPP — КЛЮЧИ И НАСТРОЙКИ (.env)
# ====================================================================

# 0. API BASE URL (для кастомного домена фронтенда или единого монолита)
VITE_API_BASE_URL="https://trainer-ai-bot.onrender.com"

# 1. GITHUB INTEGRATION
# Personal Access Token с правами repo (ghp_...)
GITHUB_TOKEN=""

# 2. AI TUNNEL LLM PROVIDER
# Ключ API и настройки шлюза AI Tunnel (api.aitunnel.ru)
AITUNNEL_API_KEY=""
AITUNNEL_BASE_URL="https://api.aitunnel.ru/v1"
AITUNNEL_MODEL="gpt-6-luna-pro"

# 3. POSTGRESQL DATABASE
# Строка подключения к PostgreSQL на Render.com (например, trainer_ai_db_ecqk)
# Формат: postgresql://user:password@host/database_name
DATABASE_URL="postgresql://user:password@dpg-daojjv142hec73a4hhog-a.oregon-postgres.render.com/trainer_ai_db_ecqk"

# 4. SERVER PORT
PORT=3000
