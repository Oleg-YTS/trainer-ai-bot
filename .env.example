APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
PORT=10000
WEBHOOK_PATH=/telegram/webhook
# на Render подставляется автоматически (RENDER_EXTERNAL_URL), локально можно указать туннель
WEBHOOK_BASE_URL=
# 1-256 символов, только A-Z a-z 0-9 _ -
WEBHOOK_SECRET_TOKEN=
# AI Tunnel (OpenAI-compatible API); ключ задаётся в окружении, не в репозитории
AI_PROVIDER=ai_tunnel
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gpt-6-luna-pro
# устаревшая конфигурация OpenAI (не используется провайдером ai_tunnel)
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=postgresql+asyncpg://trainer:trainer@localhost:5432/trainer_ai
TRAINER_ID=1
