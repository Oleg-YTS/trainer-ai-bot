# ====================================================================
# CONFIGURATION & ENVIRONMENT VARIABLES (.env)
# Скопируйте этот файл в .env и заполните необходимые значения
# ====================================================================

# --------------------------------------------------------------------
# 1. Сервер и Интеграция Фронтенда
# --------------------------------------------------------------------
PORT=3000

# URL существующего бэкенда бота на Render.com
# Пример: VITE_API_BASE_URL=https://trainer-ai-bot.onrender.com
VITE_API_BASE_URL=

# --------------------------------------------------------------------
# 2. Telegram Bot & Интеграция
# --------------------------------------------------------------------
# Токен вашего бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID тренера / админа для отправки уведомлений об эскалациях
TELEGRAM_ADMIN_CHAT_ID=

# ID тренера в системе (по умолчанию: 1)
TRAINER_ID=1

# --------------------------------------------------------------------
# 3. Ключи и настройки AI-Провайдеров (LLM)
# --------------------------------------------------------------------
# Выбор провайдера: ai_tunnel | gemini | openai | auto (по умолчанию auto)
AI_PROVIDER=ai_tunnel

# 1) AITunnel / Любой OpenAI-совместимый провайдер
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gpt-6-luna-pro

# 2) Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 3) OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --------------------------------------------------------------------
# 4. GitHub Пуш и Автодеплой
# --------------------------------------------------------------------
# Ваш Personal Access Token от GitHub с правами repo (ghp_...)
GITHUB_TOKEN=

# Ссылка на ваш репозиторий GitHub
GITHUB_REPO_URL=
